{
  "version": "2.0.0",
  "tasks": [
    {
      // Ctrl+Shift+B runs this. Uses "python -m streamlit" rather than a
      // bare "streamlit" so it works even when the Scripts directory isn't
      // on PATH.
      "label": "Run SkillGauge AI",
      "type": "shell",
      "command": "python -m streamlit run final.py",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "group": { "kind": "build", "isDefault": true },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Install dependencies",
      "type": "shell",
      "command": "python -m pip install -r requirements.txt",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always" },
      "problemMatcher": []
    },
    {
      "label": "Check setup (env + MySQL + Azure)",
      "type": "shell",
      "command": "python check_setup.py",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always" },
      "problemMatcher": []
    }
  ]
}
