{
  "version": "0.2.0",
  "configurations": [
    {
      // Press F5 to launch the app. Streamlit apps must be started through
      // the streamlit CLI - running "python final.py" executes the script
      // bare and floods the console with "missing ScriptRunContext!".
      "name": "Run SkillGauge AI (Streamlit)",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "final.py"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
