# Copy this file to ".env" (same folder) and fill in the real key.
# ".env" is git-ignored — it will never be committed.

AZURE_OPENAI_ENDPOINT=https://sev045-openai.openai.azure.com/
AZURE_OPENAI_API_KEY=paste-your-key-1-here
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5.6-sol
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large

SENDER_EMAIL=your-sender@gmail.com
EMAIL_APP_PASSWORD=paste-gmail-app-password-here

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

RECRUITER_USERNAME=recruiter
RECRUITER_PASSWORD=change-me

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=skillup_db
MYSQL_USER=skillup_app
MYSQL_PASSWORD=paste-the-skillup_app-password-here
